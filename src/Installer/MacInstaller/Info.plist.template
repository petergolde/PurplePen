<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Info.plist.template

    Template for the app bundle's Info.plist. build-mac-app.sh substitutes the
    at-sign-delimited tokens below and writes the result to
    PurplePen.app/Contents/Info.plist.
-->
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>@EXECUTABLE@</string>

    <!-- Shown in the macOS menu bar. Limited to 15 characters. -->
    <key>CFBundleName</key>
    <string>@BUNDLE_NAME@</string>

    <!-- Shown in Finder and the Dock. May be longer than 15 characters. -->
    <key>CFBundleDisplayName</key>
    <string>@DISPLAY_NAME@</string>

    <key>CFBundleIdentifier</key>
    <string>@BUNDLE_ID@</string>

    <key>CFBundleIconFile</key>
    <string>@ICON_NAME@</string>

    <!-- User-visible version, e.g. 4.0.0 -->
    <key>CFBundleShortVersionString</key>
    <string>@SHORT_VERSION@</string>

    <!-- Build version, must increase with every release submitted. -->
    <key>CFBundleVersion</key>
    <string>@BUILD_VERSION@</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <key>NSHumanReadableCopyright</key>
    <string>@COPYRIGHT@</string>

    <key>LSMinimumSystemVersion</key>
    <string>@MIN_MACOS_VERSION@</string>

    <!-- Required for crisp rendering on Retina displays. -->
    <key>NSHighResolutionCapable</key>
    <true/>

    <!-- Regular app: shows in the Dock and has a menu bar. -->
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.sports</string>

    <!--
        File type association for .ppen course files.

        Finder does not pass a double-clicked file on the command line; it
        sends the app an "open documents" event, which AvPurplePen receives
        through Avalonia's IActivatableLifetime (see App.axaml.cs).

        UTExportedTypeDeclarations defines the .ppen type itself (a .ppen file
        is XML); CFBundleDocumentTypes then claims it as Purple Pen's own.
        The identifier is fixed, not derived from the bundle ID, so that it
        stays the same across beta and release builds.
    -->
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>org.purple-pen.ppen</string>
            <key>UTTypeDescription</key>
            <string>Purple Pen Course File</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.xml</string>
                <string>public.data</string>
            </array>
            <key>UTTypeIconFile</key>
            <string>@ICON_NAME@</string>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>ppen</string>
                </array>
            </dict>
        </dict>
    </array>

    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Purple Pen Course File</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>org.purple-pen.ppen</string>
            </array>
            <key>CFBundleTypeIconFile</key>
            <string>@ICON_NAME@</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
        </dict>
    </array>
</dict>
</plist>
