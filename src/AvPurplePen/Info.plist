<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Info.plist

    The macOS app bundle's Info.plist, used only when building for net10.0-macos.
    The .NET macOS SDK merges this with the keys it computes itself and writes the
    result to PurplePen.app/Contents/Info.plist.

    Deliberately NOT here, because the SDK sets them from AvPurplePen.csproj and would
    complain about (or override) a conflicting value:

        CFBundleExecutable          from AssemblyName
        CFBundleIdentifier          from ApplicationId
        CFBundleShortVersionString  from ApplicationDisplayVersion (PurplePenCore/VersionNumber.cs)
        CFBundleVersion             from ApplicationVersion        (PurplePenCore/VersionNumber.cs)
        LSMinimumSystemVersion      from SupportedOSPlatformVersion
        CFBundlePackageType, CFBundleInfoDictionaryVersion, CFBundleSupportedPlatforms, DT*
-->
<plist version="1.0">
<dict>
    <!-- Shown in the macOS menu bar. Limited to 15 characters. -->
    <key>CFBundleName</key>
    <string>Purple Pen</string>

    <!-- Shown in Finder and the Dock. May be longer than 15 characters. -->
    <key>CFBundleDisplayName</key>
    <string>Purple Pen</string>

    <!-- Built from Assets/AppIcon by the BuildMacAppIcon target in AvPurplePen.csproj. -->
    <key>CFBundleIconFile</key>
    <string>PurplePen.icns</string>

    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2006-2026 Peter Golde. All rights reserved.</string>

    <!-- Required for crisp rendering on Retina displays. -->
    <key>NSHighResolutionCapable</key>
    <true/>

    <!-- Regular app: shows in the Dock and has a menu bar. -->
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.sports</string>

    <!--
        File type association for .ppen course files.

        Finder does not pass a double-clicked file on the command line; it
        sends the app an "open documents" event, which AvPurplePen receives
        through Avalonia's IActivatableLifetime (see App.axaml.cs).

        UTExportedTypeDeclarations defines the .ppen type itself (a .ppen file
        is XML); CFBundleDocumentTypes then claims it as Purple Pen's own.
        The identifier is fixed, not derived from the bundle ID, so that it
        stays the same across beta and release builds.
    -->
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>org.purple-pen.ppen</string>
            <key>UTTypeDescription</key>
            <string>Purple Pen Course File</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.xml</string>
                <string>public.data</string>
            </array>
            <key>UTTypeIconFile</key>
            <string>PurplePen.icns</string>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>ppen</string>
                </array>
            </dict>
        </dict>
    </array>

    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Purple Pen Course File</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>org.purple-pen.ppen</string>
            </array>
            <key>CFBundleTypeIconFile</key>
            <string>PurplePen.icns</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
        </dict>
    </array>
</dict>
</plist>
