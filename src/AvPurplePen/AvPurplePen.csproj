<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The target framework depends on the OS doing the build:
           Windows      net10.0-windows  so the app can call Windows-only APIs (Windows
                                         Forms printing). Code using them goes inside
                                         #if WINDOWS.
           macOS        net10.0-macos    so the app can call AppKit and other macOS APIs
                                         through the Microsoft.macOS bindings. Code using
                                         them goes inside #if MACOS. Needs the .NET "macos"
                                         workload and the matching Xcode; see
                                         Installer/MacInstaller/README.md.
           Linux        net10.0
         WINDOWS and MACOS are defined automatically by the SDK for those target
         frameworks. To check the plain cross-platform build, pass
         -p:TargetWindowsFramework=false (on Windows) or -p:TargetMacFramework=false (on
         macOS). Overriding TargetFramework directly with -f doesn't work: restore
         ignores it and still restores the OS-specific framework. -->
    <TargetWindowsFramework Condition="'$(TargetWindowsFramework)' == ''">$([MSBuild]::IsOSPlatform('Windows'))</TargetWindowsFramework>
    <TargetMacFramework Condition="'$(TargetMacFramework)' == ''">$([MSBuild]::IsOSPlatform('OSX'))</TargetMacFramework>
    <TargetFramework Condition="'$(TargetWindowsFramework)' == 'true'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(TargetWindowsFramework)' != 'true' And '$(TargetMacFramework)' == 'true'">net10.0-macos</TargetFramework>
    <TargetFramework Condition="'$(TargetWindowsFramework)' != 'true' And '$(TargetMacFramework)' != 'true'">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyTitle>Purple Pen</AssemblyTitle>
    <Product>Purple Pen</Product>
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <ApplicationIcon>Assets\AppIcon\PurplePenBeta.ico</ApplicationIcon>
  </PropertyGroup>
  <!-- Windows Forms is only usable (and only allowed by the SDK) for a -windows
       target framework, so key it off the TFM actually being built rather than the
       host OS. -->
  <PropertyGroup Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'windows'">
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <!-- macOS: the SDK builds a real PurplePen.app bundle (bin/<Config>/net10.0-macos/<RID>/PurplePen.app),
       with the managed assemblies in Contents/MonoBundle and a native launcher in Contents/MacOS.
       Info.plist in this directory supplies the static keys (document types, menu-bar name, ...);
       the SDK fills in the executable name, identifier, versions and LSMinimumSystemVersion from
       the properties below. Installer/MacInstaller/build-mac-app.sh signs, notarizes and packages
       the bundle this produces. -->
  <PropertyGroup Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'macos'">
    <!-- WinExe is not a valid output type for macOS. -->
    <OutputType>Exe</OutputType>
    <!-- Becomes LSMinimumSystemVersion. Keep at or above the minimum macOS that the bundled
         .NET runtime supports; set too low, the app launches on an unsupported system and crashes. -->
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
    <!-- CFBundleIdentifier. Must stay stable across releases: changing it makes macOS treat the
         app as a different application (losing its settings, permissions and file associations). -->
    <ApplicationId>org.purple-pen.PurplePen</ApplicationId>
    <!-- No ApplicationTitle: in .NET 10 it also renames the bundle ("Purple Pen.app"), and existing
         installs are PurplePen.app, so a drag-install from the .dmg would leave two copies side by
         side. Without it the bundle is named after AssemblyName; CFBundleDisplayName is set in
         Info.plist instead. -->
    <!-- The versions come from PurplePenCore/VersionNumber.cs, so there is one place to change
         them. Apple wants at most three components in the user-visible CFBundleShortVersionString,
         so the fourth (the release-stage number) appears only in CFBundleVersion. -->
    <_PurplePenVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../PurplePenCore/VersionNumber.cs')), 'Current\s*=\s*"([0-9.]+)"').Groups[1].Value)</_PurplePenVersion>
    <ApplicationVersion>$(_PurplePenVersion)</ApplicationVersion>
    <ApplicationDisplayVersion>$([System.Text.RegularExpressions.Regex]::Match('$(_PurplePenVersion)', '^\d+(\.\d+){0,2}').Value)</ApplicationDisplayVersion>
    <!-- Which icon family in Assets/AppIcon the bundle's .icns is built from: PurplePenBeta for
         beta builds, PurplePen for releases. build-mac-app.sh passes its ICON_FAMILY setting. -->
    <MacIconFamily Condition="'$(MacIconFamily)' == ''">PurplePenBeta</MacIconFamily>
    <!-- For Release builds the macOS SDK turns on a set of size-saving runtime feature switches
         meant for phone apps. This one replaces .NET's own exception messages with bare resource
         keys ("IO_FileNotFound_FileName" instead of "Could not find file ..."), and Purple Pen
         shows those messages to users in its error dialogs and crash reports. Keep them. -->
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <!-- The SDK's documented hook for adding generated bundle resources (see AddMacAppIcon). -->
    <CollectBundleResourcesDependsOn>AddMacAppIcon;$(CollectBundleResourcesDependsOn)</CollectBundleResourcesDependsOn>
  </PropertyGroup>
  <ItemGroup Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'macos'">
    <!-- The pre-rendered PNGs that make up the .icns, used at their native pixel sizes so any
         hand-tuning of the small sizes survives. Each logical size in an .iconset needs a 1x and
         a 2x file, so the 256 and 512 pixel images each appear twice under different names. -->
    <_MacIconsetPng Include="Assets\AppIcon\$(MacIconFamily).16x16.png" IconsetName="icon_16x16.png" />
    <_MacIconsetPng Include="Assets\AppIcon\$(MacIconFamily).32x32.png" IconsetName="icon_16x16@2x.png" />
    <_MacIconsetPng Include="Assets\AppIcon\$(MacIconFamily).32x32.png" IconsetName="icon_32x32.png" />
    <_MacIconsetPng Include="Assets\AppIcon\$(MacIconFamily).64x64.png" IconsetName="icon_32x32@2x.png" />
    <_MacIconsetPng Include="Assets\AppIcon\$(MacIconFamily).128x128.png" IconsetName="icon_128x128.png" />
    <_MacIconsetPng Include="Assets\AppIcon\$(MacIconFamily).256x256.png" IconsetName="icon_128x128@2x.png" />
    <_MacIconsetPng Include="Assets\AppIcon\$(MacIconFamily).256x256.png" IconsetName="icon_256x256.png" />
    <_MacIconsetPng Include="Assets\AppIcon\$(MacIconFamily).512x512.png" IconsetName="icon_256x256@2x.png" />
    <_MacIconsetPng Include="Assets\AppIcon\$(MacIconFamily).512x512.png" IconsetName="icon_512x512.png" />
    <_MacIconsetPng Include="Assets\AppIcon\$(MacIconFamily).1024x1024.png" IconsetName="icon_512x512@2x.png" />
  </ItemGroup>

  <!-- Builds the bundle's PurplePen.icns from the PNGs above with iconutil (part of every macOS
       install, no Xcode needed), and adds it to Contents/Resources. Info.plist refers to it by
       name. The output name includes the family so that switching family rebuilds it. -->
  <Target Name="BuildMacAppIcon"
          Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'macos'"
          Inputs="@(_MacIconsetPng)"
          Outputs="$(IntermediateOutputPath)$(MacIconFamily).icns">
    <PropertyGroup>
      <_MacIconsetDir>$(IntermediateOutputPath)$(MacIconFamily).iconset</_MacIconsetDir>
    </PropertyGroup>
    <RemoveDir Directories="$(_MacIconsetDir)" />
    <Copy SourceFiles="@(_MacIconsetPng)" DestinationFiles="@(_MacIconsetPng->'$(_MacIconsetDir)/%(IconsetName)')" />
    <Exec Command="iconutil --convert icns &quot;$(_MacIconsetDir)&quot; --output &quot;$(IntermediateOutputPath)$(MacIconFamily).icns&quot;" />
    <RemoveDir Directories="$(_MacIconsetDir)" />
  </Target>
  <Target Name="AddMacAppIcon"
          DependsOnTargets="BuildMacAppIcon"
          Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'macos'">
    <ItemGroup>
      <BundleResource Include="$(IntermediateOutputPath)$(MacIconFamily).icns" LogicalName="PurplePen.icns" />
    </ItemGroup>
  </Target>

  <!-- The macOS SDK only knows where to put assemblies, native libraries and resources in the
       bundle; for any other CopyToOutputDirectory file it warns "does not specify a
       'PublishFolderType'" and leaves the file out. Ours (the fonts and symbols.xml from
       PurplePenCore, and the sample event) are looked up next to the assemblies (see
       Util.GetFileInAppDirectory), so send them to Contents/MonoBundle along with the assemblies,
       keeping their subdirectories. -->
  <Target Name="PlaceMacContentFiles"
          BeforeTargets="_ComputePublishLocation"
          Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'macos'">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
                             PublishFolderType="Assembly"
                             Condition="'%(ResolvedFileToPublish.PublishFolderType)' == '' And
                                        ('%(Extension)' == '.ttf' Or '%(Extension)' == '.otf' Or
                                         '%(Extension)' == '.ppen' Or '%(Extension)' == '.ocd' Or
                                         '%(Filename)%(Extension)' == 'symbols.xml')" />
    </ItemGroup>
  </Target>

  <!-- The macOS SDK also forces "hybrid" globalization on, which takes culture data, sorting and
       casing from Apple's Foundation APIs instead of ICU, with documented differences in behavior
       and some CompareOptions that throw PlatformNotSupportedException. Turn it back off so the Mac
       build formats, sorts and compares exactly as the Windows and Linux builds (and the earlier
       net10.0 Mac build) do; plain macOS still provides ICU as libicucore. The SDK sets the property
       unconditionally in its own targets, after anything a project or Directory.Build.targets
       can set, so it has to be overridden here, in a target, along with the runtimeconfig item
       already created from it. That item is replaced with Remove and Include: inside a target,
       MSBuild ignores Update, and an item element with only metadata then sets that metadata on
       every item of the type, which once turned off every runtime feature switch at once. -->
  <Target Name="DisableMacHybridGlobalization"
          BeforeTargets="PrepareForBuild"
          Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'macos'">
    <PropertyGroup>
      <HybridGlobalization>false</HybridGlobalization>
    </PropertyGroup>
    <ItemGroup>
      <RuntimeHostConfigurationOption Remove="System.Globalization.Hybrid" />
      <RuntimeHostConfigurationOption Include="System.Globalization.Hybrid" Value="false" Trim="true" />
    </ItemGroup>
  </Target>

  <!-- Platform\Windows holds the Windows-only implementations of platform services
       (e.g. printing through Windows Forms). Compile it only for a -windows target framework. -->
  <ItemGroup Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' != 'windows'">
    <Compile Remove="Platform\Windows\**" />
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>$(DefineConstants);PORTING</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>$(DefineConstants);PORTING</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\doc\userdocs\Sample\Sample Event.ppen" Link="Samples\Sample Event.ppen">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\doc\userdocs\Sample\SampleMap.ocd" Link="Samples\SampleMap.ocd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Exclude ImageSharp from ReadyToRun — it grows from 1.7 MB to 30 MB
       and is only used for metadata/format detection, not on the hot path. -->
  <ItemGroup>
    <PublishReadyToRunExclude Include="SixLabors.ImageSharp.dll" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="Avalonia.Controls.WebView" />
    <PackageReference Include="Avalonia.HtmlRenderer" />
    <PackageReference Include="Semi.Avalonia" />
    <PackageReference Include="Semi.Avalonia.DataGrid" />

    <!--Condition below is needed to remove AvaloniaUI.DiagnosticsSupport package from build output in Release configuration.-->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />

    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />

    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Avalonia\AvUtil\AvUtil.csproj" />
    <ProjectReference Include="..\MapModel\Graphics2D\Graphics2D.csproj" />
    <ProjectReference Include="..\MapModel\MapModel\MapModel.csproj" />
    <ProjectReference Include="..\MapModel\Map_PDF\Map_PDF.csproj" />
    <ProjectReference Include="..\MapModel\Map_SkiaStd\Map_SkiaStd.csproj" />
    <ProjectReference Include="..\PdfConverter\PdfConverter.csproj" />
    <ProjectReference Include="..\PurplePenCore\PurplePenCore.csproj" />
    <ProjectReference Include="..\PurplePenViewModels\PurplePenViewModels.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="UIText.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>UIText.resx</DependentUpon>
    </Compile>
    <Compile Update="Views\Dialogs\SwitchLanguageDialog.axaml.cs">
      <DependentUpon>SwitchLanguageDialog.axaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="UIText.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>UIText.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="UIText.*.resx">
      <DependentUpon>UIText.resx</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
  <PropertyGroup>
    <AssemblyName>PurplePen</AssemblyName>
    <RootNamespace>AvPurplePen</RootNamespace>
  </PropertyGroup>
</Project>
