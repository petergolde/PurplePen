<!--
    MainWindow.axaml
    Main application window for Purple Pen.
    Migrated from WinForms PurplePen/MainFrame.cs.

    The main menu is declared as a NativeMenu (see NativeMenu.Menu below) rather than as an
    ordinary Menu. On macOS the menu is exported to the system menu bar at the top of the screen;
    on Windows and Linux the NativeMenuBar in the layout below renders exactly the same items as
    an in-window Menu.

    Layout structure:
      DockPanel (root)
        ├── NativeMenuBar — docked Top (renders the main menu on Windows/Linux; empty on macOS)
        ├── Toolbar panel — docked Top
        ├── TabControl (courseTabs) — docked Top
        ├── Status bar Grid — docked Bottom
        └── Main content Grid with GridSplitter — fills remaining space
              ├── Left panel (splitDescription equivalent)
              │     ├── Description/Topology area with radio buttons
              │     ├── GridSplitter (horizontal)
              │     └── Selection panel
              └── Right panel
                    ├── coursePartBanner (top)
                    └── Map viewer with scroll bars
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PurplePen.ViewModels"
        xmlns:resx="using:AvPurplePen"
        xmlns:views="using:AvPurplePen"
        xmlns:avutil="using:AvUtil"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="958" d:DesignHeight="600"
        x:Class="AvPurplePen.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/AppIcon/PurplePenBeta.32x32.png"
        Title="{Binding WindowTitle}"
        MapMousePointerShape="{Binding MapMousePointerShape}"
        >

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!-- These duplicate the main menu's shortcut keys. On macOS the native menu handles its own
         key equivalents, so these are redundant there, but they are kept in step with the menu
         (Command instead of Ctrl) so the window still answers the right keys on its own. Escape
         and Delete are carried only here: the menu deliberately declares no gesture for them on
         macOS, since a menu key equivalent would intercept those keys program-wide. -->
    <Window.KeyBindings>
        <KeyBinding Gesture="{OnPlatform Default='Ctrl+O', macOS='Cmd+O'}" Command="{Binding FileOpenPurplePenFileCommand}"/>
        <KeyBinding Gesture="{OnPlatform Default='Ctrl+S', macOS='Cmd+S'}" Command="{Binding SaveCommand}"/>
        <KeyBinding Gesture="{OnPlatform Default='Ctrl+P', macOS='Cmd+P'}" Command="{Binding PrintDescriptionsCommand}"/>
        <KeyBinding Gesture="Escape" Command="{Binding EscapeKeyCommand}"/>
        <KeyBinding Gesture="{OnPlatform Default='Ctrl+Z', macOS='Cmd+Z'}" Command="{Binding UndoCommand}"/>
        <KeyBinding Gesture="{OnPlatform Default='Ctrl+Y', macOS='Cmd+Y'}" Command="{Binding RedoCommand}"/>
        <KeyBinding Gesture="Delete" Command="{Binding DeleteSelectionCommand}"/>
        <!-- The key labelled "delete" on a Mac keyboard is Backspace; Key.Delete is forward delete,
             which a MacBook only has as fn+delete. Bind Backspace as well there so the obvious key
             works. A null gesture never matches, so this binding is inert off macOS. -->
        <KeyBinding Gesture="{OnPlatform Default={x:Null}, macOS='Back'}" Command="{Binding DeleteSelectionCommand}"/>
        <KeyBinding Gesture="F2" Command="{Binding ViewEntireCourseCommand}"/>
        <KeyBinding Gesture="F3" Command="{Binding ViewEntireMapCommand}"/>
        <KeyBinding Gesture="F4" Command="{Binding ToggleAllControlsCommand}"/>
        <KeyBinding Gesture="F5" Command="{Binding ShowOtherCoursesCommand}"/>
        <KeyBinding Gesture="Shift+F5" Command="{Binding ClearOtherCoursesCommand}"/>
        <KeyBinding Gesture="{OnPlatform Default='Ctrl+A', macOS='Cmd+A'}" Command="{Binding AddControlCommand}"/>
        <KeyBinding Gesture="{OnPlatform Default='Ctrl+B', macOS='Cmd+B'}" Command="{Binding AddBendCommand}"/>
        <KeyBinding Gesture="{OnPlatform Default='Ctrl+Shift+B', macOS='Cmd+Shift+B'}" Command="{Binding RemoveBendCommand}"/>
        <KeyBinding Gesture="{OnPlatform Default='Ctrl+G', macOS='Cmd+G'}" Command="{Binding AddGapCommand}"/>
        <KeyBinding Gesture="{OnPlatform Default='Ctrl+Shift+G', macOS='Cmd+Shift+G'}" Command="{Binding RemoveGapCommand}"/>
        <KeyBinding Gesture="F1" Command="{Binding HelpContentsCommand}"/>
     </Window.KeyBindings>

    <Window.Styles>
        <!-- NativeMenuBar builds each item's icon as an <Image> with no explicit size, so the
             bitmap would otherwise render at its natural size. Every menu icon is meant to be
             16x16, but a couple of the source bitmaps are larger. -->
        <Style Selector="NativeMenuBar Image">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
        </Style>
    </Window.Styles>

    <!-- ==================== MAIN MENU ==================== -->
    <!-- Declared as a NativeMenu so that macOS puts it in the system menu bar. On Windows and
         Linux the NativeMenuBar in the layout below renders these same items as an in-window
         menu. NativeMenuItem is not a Control, so it supports no x:Name and no styling; the
         properties it does support (Header, Icon, Gesture, Command, CommandParameter, IsEnabled,
         IsVisible, ToggleType, IsChecked) are mapped one-for-one onto MenuItem by NativeMenuBar.

         Shortcut keys use OnPlatform, because Avalonia does no Ctrl-to-Command mapping of its own:
         KeyGesture.Matches compares modifiers exactly, and the macOS backend reports Command as
         Meta, so a gesture written as Ctrl+O really does mean Control+O there. On macOS the Escape
         and Delete gestures are dropped entirely (macOS={x:Null}), because AppKit matches a menu
         key equivalent before the keystroke reaches the focused control, so those two would
         stop working in text fields and everywhere else. Both keys still work through
         Window.KeyBindings above, which is deliberately left alone on every platform. -->
    <NativeMenu.Menu>
        <NativeMenu>

            <!-- === File Menu === -->
            <NativeMenuItem Header="{resx:Localize MainFrame_fileMenu_Text}">
                <NativeMenu>
                    <NativeMenuItem Header="{resx:Localize MainFrame_newEventMenu_Text}" Command="{Binding NewEventCommand}"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_openMenu_Text}" Gesture="{OnPlatform Default='Ctrl+O', macOS='Cmd+O'}" Command="{Binding FileOpenPurplePenFileCommand}"
                                    Icon="/Assets/Toolbar/open.png"/>
                    <NativeMenuItemSeparator/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_saveMenu_Text}" Gesture="{OnPlatform Default='Ctrl+S', macOS='Cmd+S'}" Command="{Binding SaveCommand}"
                                    Icon="/Assets/Toolbar/save.png"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_saveAsMenu_Text}" Command="{Binding SaveAsCommand}"/>
                    <NativeMenuItemSeparator/>
                    <NativeMenuItem Header="{Binding CreateOcadFilesCommandName}" Command="{Binding CreateOcadFilesCommand}"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_createImageFilesMenu_Text}" Command="{Binding CreateImageFilesCommand}"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_createPDFsMenu_Text}">
                        <NativeMenu>
                            <NativeMenuItem Header="{resx:Localize MainFrame_createDescriptionPdfMenu_Text}" Command="{Binding CreateDescriptionPdfCommand}"/>
                            <NativeMenuItem Header="{resx:Localize MainFrame_createPunchcardPdfMenu_Text}" Command="{Binding CreatePunchcardPdfCommand}"/>
                            <NativeMenuItem Header="{resx:Localize MainFrame_createCoursePdfMenu_Text}" Command="{Binding CreateCoursePdfCommand}"/>
                        </NativeMenu>
                    </NativeMenuItem>
                    <NativeMenuItem Header="{resx:Localize MainFrame_createRouteReviewFilesToolStripMenuItem_Text}">
                        <NativeMenu>
                            <NativeMenuItem Header="{resx:Localize MainFrame_createRouteGadgetFilesMenu_Text}" Command="{Binding CreateRouteGadgetFilesCommand}"/>
                        </NativeMenu>
                    </NativeMenuItem>
                    <NativeMenuItem Header="{resx:Localize MainFrame_createXmlMenu_Text}" Command="{Binding CreateXmlCommand}"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_createGPXFileMenu_Text}" Command="{Binding CreateGpxCommand}"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_createKMLFileMenu_Text}" Command="{Binding CreateKmlFilesCommand}"/>
                    <NativeMenuItemSeparator/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_printDescriptionsMenu_Text}" Gesture="{OnPlatform Default='Ctrl+P', macOS='Cmd+P'}" Command="{Binding PrintDescriptionsCommand}"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_printPunchCardsMenu_Text}" Command="{Binding PrintPunchCardsCommand}"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_printCoursesMenu_Text}" Command="{Binding PrintCoursesCommand}"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_setPrintAreaMenu_Text}">
                        <NativeMenu>
                            <NativeMenuItem Header="{resx:Localize MainFrame_printAreaThisPartMenu_Text}" IsVisible="{Binding IsVisibleSetPrintAreaThisPart}" Command="{Binding SetPrintAreaThisPartCommand}"/>
                            <NativeMenuItem Header="{resx:Localize MainFrame_printAreaThisCourseMenu_Text}" Command="{Binding SetPrintAreaThisCourseCommand}"/>
                            <NativeMenuItem Header="{resx:Localize MainFrame_printAreaAllCoursesMenu_Text}" Command="{Binding SetPrintAreaAllCoursesCommand}"/>
                        </NativeMenu>
                    </NativeMenuItem>
                    <!-- Program Language moves to the application menu on macOS; see MacMainMenu.cs. -->
                    <NativeMenuItemSeparator IsVisible="{Binding IsNotMacOS}"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_programLanguageMenu_Text}"
                                    IsVisible="{Binding IsNotMacOS}"
                                    Command="{Binding ShowSwitchLanguageDialogCommand}"/>
                    <!-- Exit is Quit on macOS, which Avalonia puts in the application menu. -->
                    <NativeMenuItemSeparator IsVisible="{Binding IsNotMacOS}"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_exitMenu_Text}"
                                    IsVisible="{Binding IsNotMacOS}"
                                    Command="{Binding ExitCommand}"/>
                </NativeMenu>
            </NativeMenuItem>

            <!-- === Edit Menu === -->
            <!-- The Undo/Redo icons gray out when the command is unavailable. A NativeMenuItem
                 cannot bind to its own enabled state the way an Image inside a MenuItem could,
                 so the icon binds to the same ViewModel flag that drives the command instead. -->
            <NativeMenuItem Header="{resx:Localize MainFrame_editMenu_Text}">
                <NativeMenu>
                    <NativeMenuItem Header="{resx:Localize MiscText_CancelOperationWithShortcut}"
                                    Gesture="{OnPlatform Default='Escape', macOS={x:Null}}"
                                    IsVisible="{Binding CanCancelMode}"
                                    Command="{Binding CancelCommand}"/>
                    <NativeMenuItem Header="{resx:Localize MiscText_ClearSelectionWithShortcut}"
                                    Gesture="{OnPlatform Default='Escape', macOS={x:Null}}"
                                    IsVisible="{Binding CanClearSelection}"
                                    Command="{Binding ClearSelectionCommand}"/>
                    <NativeMenuItemSeparator/>
                    <NativeMenuItem Header="{Binding UndoCommandName}" Gesture="{OnPlatform Default='Ctrl+Z', macOS='Cmd+Z'}" Command="{Binding UndoCommand}"
                                    Icon="{Binding CanUndo,
                                           Converter={x:Static avutil:DisabledImageConverter.Instance},
                                           ConverterParameter=/Assets/Toolbar/undo.png}"/>
                    <NativeMenuItem Header="{Binding RedoCommandName}" Gesture="{OnPlatform Default='Ctrl+Y', macOS='Cmd+Y'}" Command="{Binding RedoCommand}"
                                    Icon="{Binding CanRedo,
                                           Converter={x:Static avutil:DisabledImageConverter.Instance},
                                           ConverterParameter=/Assets/Toolbar/redo.png}"/>
                    <NativeMenuItemSeparator/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_deleteMenu_Text}" Gesture="{OnPlatform Default='Delete', macOS={x:Null}}" Command="{Binding DeleteSelectionCommand}"
                                    Icon="/Assets/Toolbar/delete.png"/>
                </NativeMenu>
            </NativeMenuItem>

            <!-- === View Menu === -->
            <!-- The IsChecked bindings are explicitly TwoWay. Clicking a checkable item toggles its
                 check mark locally; the write-back lets the ViewModel restore the correct state on
                 the next idle update even when the underlying value did not actually change. -->
            <NativeMenuItem Header="{resx:Localize MainFrame_viewMenu_Text}">
                <NativeMenu>
                    <NativeMenuItem Header="{resx:Localize MainFrame_entireCourseMenu_Text}" Gesture="F2" Command="{Binding ViewEntireCourseCommand}"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_entireMapMenu_Text}" Gesture="F3" Command="{Binding ViewEntireMapCommand}"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_zoomMenu_Text}">
                        <NativeMenu>
                            <NativeMenuItem Header="{resx:Localize MainFrame_zoom50Menu_Text}" Command="{Binding SetZoomCommand}"
                                            CommandParameter="{Binding Source=0.5, Converter={x:Static avutil:StringToDoubleConverter.Instance}}"
                                            ToggleType="CheckBox" IsChecked="{Binding Zoom50Checked, Mode=TwoWay}"/>
                            <NativeMenuItem Header="{resx:Localize MainFrame_zoom100Menu_Text}" Command="{Binding SetZoomCommand}"
                                            CommandParameter="{Binding Source=1, Converter={x:Static avutil:StringToDoubleConverter.Instance}}"
                                            ToggleType="CheckBox" IsChecked="{Binding Zoom100Checked, Mode=TwoWay}"/>
                            <NativeMenuItem Header="{resx:Localize MainFrame_zoom150Menu_Text}" Command="{Binding SetZoomCommand}"
                                            CommandParameter="{Binding Source=1.5, Converter={x:Static avutil:StringToDoubleConverter.Instance}}"
                                            ToggleType="CheckBox" IsChecked="{Binding Zoom150Checked, Mode=TwoWay}"/>
                            <NativeMenuItem Header="{resx:Localize MainFrame_zoom200Menu_Text}" Command="{Binding SetZoomCommand}"
                                            CommandParameter="{Binding Source=2, Converter={x:Static avutil:StringToDoubleConverter.Instance}}"
                                            ToggleType="CheckBox" IsChecked="{Binding Zoom200Checked, Mode=TwoWay}"/>
                            <NativeMenuItem Header="{resx:Localize MainFrame_zoom300Menu_Text}" Command="{Binding SetZoomCommand}"
                                            CommandParameter="{Binding Source=3, Converter={x:Static avutil:StringToDoubleConverter.Instance}}"
                                            ToggleType="CheckBox" IsChecked="{Binding Zoom300Checked, Mode=TwoWay}"/>
                            <NativeMenuItem Header="{resx:Localize MainFrame_zoom500Menu_Text}" Command="{Binding SetZoomCommand}"
                                            CommandParameter="{Binding Source=5, Converter={x:Static avutil:StringToDoubleConverter.Instance}}"
                                            ToggleType="CheckBox" IsChecked="{Binding Zoom500Checked, Mode=TwoWay}"/>
                            <NativeMenuItem Header="{resx:Localize MainFrame_zoom1000Menu_Text}" Command="{Binding SetZoomCommand}"
                                            CommandParameter="{Binding Source=10, Converter={x:Static avutil:StringToDoubleConverter.Instance}}"
                                            ToggleType="CheckBox" IsChecked="{Binding Zoom1000Checked, Mode=TwoWay}"/>
                        </NativeMenu>
                    </NativeMenuItem>

                    <NativeMenuItemSeparator/>

                    <NativeMenuItem Header="{resx:Localize MainFrame_mapIntensityMenu_Text}">
                        <NativeMenu>
                            <NativeMenuItem Header="{resx:Localize MainFrame_veryLowIntensityMenu_Text}" Command="{Binding SetMapIntensityCommand}"
                                            CommandParameter="{Binding Source=0.4, Converter={x:Static avutil:StringToDoubleConverter.Instance}}"
                                            ToggleType="CheckBox" IsChecked="{Binding IntensityVeryLowChecked, Mode=TwoWay}"/>
                            <NativeMenuItem Header="{resx:Localize MainFrame_lowIntensityMenu_Text}" Command="{Binding SetMapIntensityCommand}"
                                            CommandParameter="{Binding Source=0.55, Converter={x:Static avutil:StringToDoubleConverter.Instance}}"
                                            ToggleType="CheckBox" IsChecked="{Binding IntensityLowChecked, Mode=TwoWay}"/>
                            <NativeMenuItem Header="{resx:Localize MainFrame_mediumIntensityMenu_Text}" Command="{Binding SetMapIntensityCommand}"
                                            CommandParameter="{Binding Source=0.7, Converter={x:Static avutil:StringToDoubleConverter.Instance}}"
                                            ToggleType="CheckBox" IsChecked="{Binding IntensityMediumChecked, Mode=TwoWay}"/>
                            <NativeMenuItem Header="{resx:Localize MainFrame_highIntensityMenu_Text}" Command="{Binding SetMapIntensityCommand}"
                                            CommandParameter="{Binding Source=0.85, Converter={x:Static avutil:StringToDoubleConverter.Instance}}"
                                            ToggleType="CheckBox" IsChecked="{Binding IntensityHighChecked, Mode=TwoWay}"/>
                            <NativeMenuItem Header="{resx:Localize MainFrame_fullIntensityMenu_Text}" Command="{Binding SetMapIntensityCommand}"
                                            CommandParameter="{Binding Source=1, Converter={x:Static avutil:StringToDoubleConverter.Instance}}"
                                            ToggleType="CheckBox" IsChecked="{Binding IntensityFullChecked, Mode=TwoWay}"/>
                        </NativeMenu>
                    </NativeMenuItem>

                    <NativeMenuItem Header="{resx:Localize MainFrame_mapQualityMenu_Text}">
                        <NativeMenu>
                            <NativeMenuItem Header="{resx:Localize MainFrame_normalQualityMenu_Text}"
                                            Command="{Binding SetNormalQualityCommand}"
                                            ToggleType="CheckBox" IsChecked="{Binding !HighQualityMapDisplay, Mode=TwoWay}"/>
                            <NativeMenuItem Header="{resx:Localize MainFrame_highQualityMenu_Text}"
                                            Command="{Binding SetHighQualityCommand}"
                                            ToggleType="CheckBox" IsChecked="{Binding HighQualityMapDisplay, Mode=TwoWay}"/>
                        </NativeMenu>
                    </NativeMenuItem>

                    <NativeMenuItem Header="{resx:Localize MainFrame_showPrintAreaMenu_Text}"
                                    ToggleType="CheckBox" IsChecked="{Binding ShowPrintArea, Mode=TwoWay}"
                                    Command="{Binding ToggleShowPrintAreaCommand}"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_showPopupsMenu_Text}"
                                    ToggleType="CheckBox" IsChecked="{Binding ShowToolTips, Mode=TwoWay}"
                                    Command="{Binding ToggleShowPopupsCommand}"/>

                    <NativeMenuItemSeparator/>

                    <NativeMenuItem Header="{resx:Localize MainFrame_allControlsMenu_Text}" Gesture="F4"
                                    Command="{Binding ToggleAllControlsCommand}"
                                    ToggleType="CheckBox" IsChecked="{Binding ViewAllControlsChecked, Mode=TwoWay}"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_otherCoursesMenu_Text}"
                                    Gesture="F5"
                                    Command="{Binding ShowOtherCoursesCommand}"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_clearOtherCoursesMenu_Text}"
                                    IsVisible="{Binding IsVisibleClearOtherCourses}"
                                    Gesture="Shift+F5"
                                    Command="{Binding ClearOtherCoursesCommand}"/>
                </NativeMenu>
            </NativeMenuItem>

            <!-- === Add Menu === -->
            <NativeMenuItem Header="{resx:Localize MainFrame_addMenu_Text}">
                <NativeMenu>
                    <NativeMenuItem Header="{resx:Localize MainFrame_addStartMenu_Text}" Command="{Binding AddStartCommand}"
                                    Icon="/Assets/Toolbar/addStart.png"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_addControlMenu_Text}" Gesture="{OnPlatform Default='Ctrl+A', macOS='Cmd+A'}" Command="{Binding AddControlCommand}"
                                    Icon="/Assets/Toolbar/addControl.png"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_addFinishMenu_Text}" Command="{Binding AddFinishCommand}"
                                    Icon="/Assets/Toolbar/addFinish.png"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_addDescriptionsMenu_Text}" Command="{Binding AddDescriptionsCommand}"
                                    Icon="/Assets/Toolbar/descriptionsItem.png"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_addMapExchangeMenu_Text}"
                                    Icon="/Assets/Toolbar/mapExchange.png">
                        <NativeMenu>
                            <NativeMenuItem Header="{resx:Localize MainFrame_addMapFlipMenuItem_Text}" Command="{Binding AddMapFlipControlCommand}"
                                            Icon="/Assets/Toolbar/mapFlipMenuItem.png"/>
                            <NativeMenuItem Header="{resx:Localize MainFrame_mapExchangeControlMenuItem_Text}" Command="{Binding AddMapExchangeControlCommand}"
                                            Icon="/Assets/Toolbar/mapExchangeControlItem.png"/>
                            <NativeMenuItem Header="{resx:Localize MainFrame_mapExchangeSeparateMenuItem_Text}" Command="{Binding AddMapExchangeSeparateCommand}"
                                            Icon="/Assets/Toolbar/mapExchangeSeparateItem.png"/>
                        </NativeMenu>
                    </NativeMenuItem>
                    <NativeMenuItem Header="{resx:Localize MainFrame_addVariationMenu_Text}" Command="{Binding AddVariationCommand}"
                                    Icon="/Assets/Toolbar/addVariation.png"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_addTextLineMenu_Text}" Command="{Binding AddTextLineCommand}"/>
                    <NativeMenuItemSeparator/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_addMapIssueMenu_Text}" Command="{Binding AddMapIssueCommand}"
                                    Icon="/Assets/Toolbar/mapIssuePointItem.png"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_addMandatoryCrossingMenu_Text}" Command="{Binding AddMandatoryCrossingCommand}"
                                    Icon="/Assets/Toolbar/mandatoryCrossingPointItem.png"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_addOptCrossingMenu_Text}" Command="{Binding AddOptCrossingCommand}"
                                    Icon="/Assets/Toolbar/optionalCrossingPointItem.png"/>
                    <!-- We want the out of bounds menu item to have potentially two different icons, based on the AddOutOfBoundsUsesDangerousIcon view-model property -->
                    <NativeMenuItem Header="{resx:Localize MainFrame_addOutOfBoundsMenu_Text}"
                                    IsVisible="{Binding !AddOutOfBoundsUsesDangerousIcon}"
                                    Command="{Binding AddOutOfBoundsCommand}"
                                    Icon="/Assets/Toolbar/outOfBoundsItem.png"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_addOutOfBoundsMenu_Text}"
                                    IsVisible="{Binding AddOutOfBoundsUsesDangerousIcon}"
                                    Command="{Binding AddOutOfBoundsCommand}"
                                    Icon="/Assets/Toolbar/dangerousItem.png"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_addDangerousMenu_Text}"
                                    IsVisible="{Binding IsVisibleDangerousArea}"
                                    Command="{Binding AddDangerousCommand}"
                                    Icon="/Assets/Toolbar/dangerousItem.png"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_addConstructionMenu_Text}" Command="{Binding AddConstructionCommand}"
                                    Icon="/Assets/Toolbar/constructionItem.png"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_addWaterMenu_Text}" Command="{Binding AddWaterCommand}"
                                    Icon="/Assets/Toolbar/waterLocationItem.png"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_addFirstAidMenu_Text}" Command="{Binding AddFirstAidCommand}"
                                    Icon="/Assets/Toolbar/firstAidLocationItem.png"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_addForbiddenMenu_Text}" Command="{Binding AddForbiddenCommand}"
                                    Icon="/Assets/Toolbar/forbiddenRouteMarkingItem.png"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_addBoundaryMenu_Text}" Command="{Binding AddBoundaryCommand}"
                                    Icon="/Assets/Toolbar/boundaryItem.png"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_addRegMarkMenu_Text}" Command="{Binding AddRegMarkCommand}"
                                    Icon="/Assets/Toolbar/registrationMarkItem.png"/>
                    <NativeMenuItemSeparator/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_whiteOutMenu_Text}" Command="{Binding AddWhiteOutCommand}"
                                    Icon="/Assets/Toolbar/whiteOutItem.png"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_addTextMenu_Text}" Command="{Binding AddTextCommand}"
                                    Icon="/Assets/Toolbar/textItem.png"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_addImageMenu_Text}" Command="{Binding AddImageCommand}"
                                    Icon="/Assets/Toolbar/imageItem.png"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_addLineMenu_Text}" Command="{Binding AddLineCommand}"
                                    Icon="/Assets/Toolbar/lineItem.png"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_addRectangleMenu_Text}" Command="{Binding AddRectangleCommand}"
                                    Icon="/Assets/Toolbar/rectangleItem.png"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_addEllipseMenu_Text}" Command="{Binding AddEllipseCommand}"
                                    Icon="/Assets/Toolbar/ellipseItem.png"/>
                </NativeMenu>
            </NativeMenuItem>

            <!-- === Event Menu === -->
            <NativeMenuItem Header="{resx:Localize MainFrame_eventMenu_Text}">
                <NativeMenu>
                    <NativeMenuItem Header="{resx:Localize MainFrame_changeMapFileMenu_Text}" Command="{Binding ChangeMapFileCommand}"/>
                    <NativeMenuItemSeparator/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_changeCodesMenu_Text}" Command="{Binding ChangeCodesCommand}"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_autoNumberingMenu_Text}" Command="{Binding AutoNumberingCommand}"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_removeUnusedControlsMenu_Text}" Command="{Binding RemoveUnusedControlsCommand}"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_moveAllControlsMenu_Text}" Command="{Binding MoveAllControlsCommand}"/>
                    <NativeMenuItemSeparator/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_punchPatternsMenu_Text}" Command="{Binding PunchPatternsCommand}"/>
                    <NativeMenuItemSeparator/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_iOFStandardsToolStripMenuItem_Text}">
                        <NativeMenu>
                            <NativeMenuItem Header="{resx:Localize MainFrame_descriptionStd2004Menu_Text}"
                                            ToggleType="CheckBox" IsChecked="{Binding DescriptionStd2004Checked, Mode=TwoWay}"
                                            Command="{Binding SetDescriptionStd2004Command}"/>
                            <NativeMenuItem Header="{resx:Localize MainFrame_descriptionStd2018Menu_Text}"
                                            ToggleType="CheckBox" IsChecked="{Binding DescriptionStd2018Checked, Mode=TwoWay}"
                                            Command="{Binding SetDescriptionStd2018Command}"/>
                            <NativeMenuItemSeparator/>
                            <NativeMenuItem Header="{resx:Localize MainFrame_mapStd2000Menu_Text}"
                                            ToggleType="CheckBox" IsChecked="{Binding MapStd2000Checked, Mode=TwoWay}"
                                            Command="{Binding SetMapStd2000Command}"/>
                            <NativeMenuItem Header="{resx:Localize MainFrame_mapStd2017Menu_Text}"
                                            ToggleType="CheckBox" IsChecked="{Binding MapStd2017Checked, Mode=TwoWay}"
                                            Command="{Binding SetMapStd2017Command}"/>
                            <NativeMenuItem Header="{resx:Localize MainFrame_mapStdSpr2019Menu_Text}"
                                            ToggleType="CheckBox" IsChecked="{Binding MapStdSpr2019Checked, Mode=TwoWay}"
                                            Command="{Binding SetMapStdSpr2019Command}"/>
                        </NativeMenu>
                    </NativeMenuItem>
                    <NativeMenuItem Header="{resx:Localize MainFrame_customizeDescriptionsMenu_Text}" Command="{Binding CustomizeDescriptionsCommand}"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_customizeCourseAppearanceMenu_Text}" Command="{Binding CustomizeCourseAppearanceCommand}"/>
                </NativeMenu>
            </NativeMenuItem>

            <!-- === Course Menu === -->
            <NativeMenuItem Header="{resx:Localize MainFrame_courseMenu_Text}">
                <NativeMenu>
                    <NativeMenuItem Header="{resx:Localize MainFrame_addCourseMenu_Text}" Command="{Binding ShowAddCourseDialogCommand}"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_deleteCourseMenu_Text}" Command="{Binding DeleteCourseCommand}"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_duplicateCourseMenu_Text}" Command="{Binding DuplicateCourseCommand}"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_propertiesMenu_Text}" Command="{Binding ShowCoursePropertiesCommand}"/>
                    <NativeMenuItemSeparator/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_courseOrderMenu_Text}" Command="{Binding ShowCourseOrderCommand}"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_courseLoadMenu_Text}" Command="{Binding ShowCourseLoadCommand}"/>
                    <NativeMenuItemSeparator/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_courseVariationReportMenu_Text}" Command="{Binding ShowCourseVariationReportCommand}"/>
                </NativeMenu>
            </NativeMenuItem>

            <!-- === Item Menu === -->
            <!-- As in the Edit menu, the Add Bend/Add Gap icons gray out via the ViewModel flag that
                 drives the corresponding command, since a NativeMenuItem has no self-reference. -->
            <NativeMenuItem Header="{resx:Localize MainFrame_itemMenu_Text}">
                <NativeMenu>
                    <NativeMenuItem Header="{resx:Localize MainFrame_deleteItemMenu_Text}" Gesture="{OnPlatform Default='Delete', macOS={x:Null}}"
                                    Command="{Binding DeleteSelectionCommand}"
                                    Icon="/Assets/Toolbar/delete.png"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_deleteForkMenu_Text}"
                                    Command="{Binding DeleteForkCommand}"/>
                    <NativeMenuItemSeparator/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_addBendMenu_Text}"
                                    Gesture="{OnPlatform Default='Ctrl+B', macOS='Cmd+B'}" Command="{Binding AddBendCommand}"
                                    Icon="{Binding CanAddBend,
                                           Converter={x:Static avutil:DisabledImageConverter.Instance},
                                           ConverterParameter=/Assets/Toolbar/addBend.png}"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_removeBendMenu_Text}" Gesture="{OnPlatform Default='Ctrl+Shift+B', macOS='Cmd+Shift+B'}"
                                    Command="{Binding RemoveBendCommand}"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_addGapMenu_Text}" Gesture="{OnPlatform Default='Ctrl+G', macOS='Cmd+G'}"
                                    Command="{Binding AddGapCommand}"
                                    Icon="{Binding CanAddGap,
                                           Converter={x:Static avutil:DisabledImageConverter.Instance},
                                           ConverterParameter=/Assets/Toolbar/addGap.png}"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_removeGapMenu_Text}" Gesture="{OnPlatform Default='Ctrl+Shift+G', macOS='Cmd+Shift+G'}"
                                    Command="{Binding RemoveGapCommand}"/>
                    <NativeMenuItemSeparator/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_changeTextMenu_Text}"
                                    Command="{Binding ChangeTextCommand}"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_changeLineAppearanceMenu_Text}"
                                    Command="{Binding ChangeLineAppearanceCommand}"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_rotateMenu_Text}"
                                    Command="{Binding RotateCommand}"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_stretchMenu_Text}"
                                    Command="{Binding StretchCommand}"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_legFlaggingMenu_Text}"
                                    IsEnabled="{Binding CanSetLegFlagging}">
                        <NativeMenu>
                            <NativeMenuItem Header="{resx:Localize MainFrame_noFlaggingMenu_Text}"
                                            ToggleType="CheckBox" IsChecked="{Binding NoFlaggingChecked, Mode=TwoWay}"
                                            Command="{Binding SetNoFlaggingCommand}"/>
                            <NativeMenuItem Header="{resx:Localize MainFrame_entireFlaggingMenu_Text}"
                                            ToggleType="CheckBox" IsChecked="{Binding EntireFlaggingChecked, Mode=TwoWay}"
                                            Command="{Binding SetEntireFlaggingCommand}"/>
                            <NativeMenuItem Header="{resx:Localize MainFrame_beginFlaggingMenu_Text}"
                                            ToggleType="CheckBox" IsChecked="{Binding BeginFlaggingChecked, Mode=TwoWay}"
                                            Command="{Binding SetBeginFlaggingCommand}"/>
                            <NativeMenuItem Header="{resx:Localize MainFrame_endFlaggingMenu_Text}"
                                            ToggleType="CheckBox" IsChecked="{Binding EndFlaggingChecked, Mode=TwoWay}"
                                            Command="{Binding SetEndFlaggingCommand}"/>
                        </NativeMenu>
                    </NativeMenuItem>
                    <NativeMenuItemSeparator/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_changeDisplayedCoursesMenu_Text}"
                                    Command="{Binding ChangeDisplayedCoursesCommand}"/>
                </NativeMenu>
            </NativeMenuItem>

            <!-- === Reports Menu === -->
            <NativeMenuItem Header="{resx:Localize MainFrame_reportMenu_Text}">
                <NativeMenu>
                    <NativeMenuItem Header="{resx:Localize MainFrame_courseSummaryMenu_Text}"
                                    Command="{Binding ShowCourseSummaryCommand}"
                                    CommandParameter="{resx:Localize MainFrame_courseSummaryMenu_Text}"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_eventAuditMenu_Text}"
                                    Command="{Binding ShowEventAuditCommand}"
                                    CommandParameter="{resx:Localize MainFrame_eventAuditMenu_Text}"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_legLengthsMenu_Text}"
                                    Command="{Binding ShowLegLengthsCommand}"
                                    CommandParameter="{resx:Localize MainFrame_legLengthsMenu_Text}"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_controlCrossrefMenu_Text}"
                                    Command="{Binding ShowControlCrossrefCommand}"
                                    CommandParameter="{resx:Localize MainFrame_controlCrossrefMenu_Text}"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_controlAndLegLoadMenu_Text}"
                                    Command="{Binding ShowControlAndLegLoadCommand}"
                                    CommandParameter="{resx:Localize MainFrame_controlAndLegLoadMenu_Text}"/>
                </NativeMenu>
            </NativeMenuItem>

            <!-- === Help Menu === -->
            <NativeMenuItem Header="{resx:Localize MainFrame_helpMenu_Text}">
                <NativeMenu>
                    <NativeMenuItem Header="{resx:Localize MainFrame_helpContentsMenu_Text}" Gesture="F1"
                                    Command="{Binding HelpContentsCommand}"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_helpTranslatedMenu_Text}"
                                    IsVisible="{Binding IsVisibleTranslatedWebSite}"
                                    Command="{Binding HelpTranslatedCommand}"/>
                    <NativeMenuItemSeparator/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_mainWebSiteToolMenu_Text}"
                                    Command="{Binding OpenMainWebSiteCommand}"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_supportWebSiteMenu_Text}"
                                    Command="{Binding OpenSupportWebSiteCommand}"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_donateWebSiteMenu_Text}"
                                    Command="{Binding OpenDonateWebSiteCommand}"/>
                    <!-- About moves to the application menu on macOS; see MacMainMenu.cs. -->
                    <NativeMenuItemSeparator IsVisible="{Binding IsNotMacOS}"/>
                    <NativeMenuItem Header="{resx:Localize MainFrame_aboutMenu_Text}"
                                    IsVisible="{Binding IsNotMacOS}"
                                    Command="{Binding ShowAboutDialogCommand}"/>

                    <!-- Debug submenu (shown only while Ctrl+Shift or Ctrl+Alt is held; see MainWindow.TrackModifiers) -->
                    <NativeMenuItem Header="{resx:Localize MainFrame_debugMenu_Text}" IsVisible="{Binding ShowHiddenHelpMenus}">
                        <NativeMenu>
                            <NativeMenuItem Header="{resx:Localize MainFrame_missingTranslationsMenuItem_Text}"
                                            Command="{Binding ShowMissingTranslationsCommand}"/>
                            <NativeMenuItem Header="{resx:Localize MainFrame_crashToolStripMenuItem_Text}"
                                            Command="{Binding TriggerCrashCommand}"/>
                        </NativeMenu>
                    </NativeMenuItem>

                    <!-- Translate submenu (shown only while Ctrl+Shift or Ctrl+Alt is held; see MainWindow.TrackModifiers) -->
                    <NativeMenuItem Header="{resx:Localize MainFrame_translateMenu_Text}" IsVisible="{Binding ShowHiddenHelpMenus}">
                        <NativeMenu>
                            <NativeMenuItem Header="{resx:Localize MainFrame_addDescriptionLanguageMenu_Text}"
                                            Command="{Binding AddDescriptionLanguageCommand}"/>
                            <NativeMenuItem Header="{resx:Localize MainFrame_addTranslatedTextsMenu_Text}"
                                            Command="{Binding AddTranslatedTextsCommand}"/>
                            <NativeMenuItem Header="{resx:Localize MainFrame_mergeSymbolsMenu_Text}"
                                            Command="{Binding MergeSymbolsCommand}"/>
                        </NativeMenu>
                    </NativeMenuItem>
                </NativeMenu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <DockPanel LastChildFill="True">

        <!-- Renders the NativeMenu above as an ordinary in-window Menu on Windows and Linux.
             On macOS the menu is exported to the system menu bar and this control is hidden. -->
        <NativeMenuBar DockPanel.Dock="Top"/>

        <!-- ==================== TOOLBAR ==================== -->
        <!-- Toolbar buttons arranged in a horizontal StackPanel.
             Image-only buttons show just an icon with a tooltip.
             Image+text buttons show icon and label side by side.
             Dropdown buttons are a single-item Menu (see App.axaml toolbar Menu styles) so the
             native menu gesture works: press to open, drag over items, release to select. -->
        <StackPanel x:Name="toolbar" Classes="toolbar" DockPanel.Dock="Top" Orientation="Horizontal"
                    Spacing="2" Height="28">

            <!-- Open (image only) -->
            <Button x:Name="openToolStripButton"
                    ToolTip.Tip="{resx:Localize MainFrame_openToolStripButton_ToolTipText}"
                    Command="{Binding FileOpenPurplePenFileCommand}"
                    Padding="6,2,2,2">
                <Image Source="/Assets/Toolbar/open.png" Width="16" Height="16"/>
            </Button>

            <!-- Save (image only) -->
            <Button x:Name="saveToolStripButton"
                    ToolTip.Tip="{resx:Localize MainFrame_saveToolStripButton_ToolTipText}"
                    Command="{Binding SaveCommand}"
                    Padding="2,2">
                <Image Source="/Assets/Toolbar/save.png" Width="16" Height="16"/>
            </Button>
            <Separator Width="1" Margin="3,2"/>

            <!-- Undo (image only) -->
            <Button x:Name="undoToolStripButton"
                    ToolTip.Tip="{Binding UndoToolTip}"
                    Command="{Binding UndoCommand}"
                    Padding="2,2">
                <Image Width="16" Height="16"
                       Source="{Binding IsEffectivelyEnabled,
                                RelativeSource={RelativeSource Self},
                                Converter={x:Static avutil:DisabledImageConverter.Instance},
                                ConverterParameter=/Assets/Toolbar/undo.png}"/>
            </Button>

            <!-- Redo (image only) -->
            <Button x:Name="redoToolStripButton"
                    ToolTip.Tip="{Binding RedoToolTip}"
                    Command="{Binding RedoCommand}"
                    Padding="2,2">
                <Image Width="16" Height="16"
                       Source="{Binding IsEffectivelyEnabled,
                                RelativeSource={RelativeSource Self},
                                Converter={x:Static avutil:DisabledImageConverter.Instance},
                                ConverterParameter=/Assets/Toolbar/redo.png}"/>
            </Button>
            <Separator Width="1" Margin="4,2"/>

            <!-- Delete (image only) -->
            <Button x:Name="deleteToolStripButton"
                    ToolTip.Tip="{resx:Localize MainFrame_deleteToolStripButton_Text}"
                    Command="{Binding DeleteSelectionCommand}"
                    Padding="2,2">
                <Image Source="/Assets/Toolbar/delete.png" Width="16" Height="16"/>
            </Button>
            <Separator Width="1" Margin="2,2"/>

            <!-- Add Start (image + text) -->
            <Button x:Name="addStartToolStripButton" Padding="2,2"
                    Command="{Binding AddStartCommand}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Image Source="/Assets/Toolbar/addStart.png" Width="16" Height="16"/>
                    <TextBlock Text="{resx:Localize MainFrame_addStartToolStripButton_Text}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Add Control (image + text) -->
            <Button x:Name="addControlToolStripButton"
                    ToolTip.Tip="{resx:Localize MainFrame_addControlToolStripButton_ToolTipText}"
                    Command="{Binding AddControlCommand}"
                    Padding="2,2">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Image Source="/Assets/Toolbar/addControl.png" Width="16" Height="16"/>
                    <TextBlock Text="{resx:Localize MainFrame_addControlToolStripButton_Text}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Add Finish (image + text) -->
            <Button x:Name="addFinishToolStripButton" Padding="2,2"
                    Command="{Binding AddFinishCommand}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Image Source="/Assets/Toolbar/addFinish.png" Width="16" Height="16"/>
                    <TextBlock Text="{resx:Localize MainFrame_addFinishToolStripButton_Text}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Separator Width="1" Margin="2,2"/>

            <!-- Descriptions (image + text) -->
            <Button x:Name="descriptionsToolStripMenuItem" Padding="2,2"
                    Command="{Binding AddDescriptionsCommand}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Image Source="/Assets/Toolbar/descriptionsItem.png" Width="16" Height="16"/>
                    <TextBlock Text="{resx:Localize MainFrame_descriptionsToolStripMenuItem_Text}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Map Exchange dropdown. A single-item Menu (not Button + Flyout) so the native menu
                 interaction handler provides press-to-open, drag-over, release-to-select. -->
            <Menu x:Name="mapExchangeToolStripMenu" IsEnabled="{Binding CanAddMapExchangeAny}">
                <MenuItem>
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Image Source="/Assets/Toolbar/mapExchange.png" Width="16" Height="16"/>
                            <TextBlock Text="{resx:Localize MainFrame_mapExchangeToolStripMenu_Text}"
                                       VerticalAlignment="Center"/>
                            <PathIcon Data="M1939 486L2029 576L1024 1581L19 576L109 486L1024 1401L1939 486Z"
                                     Width="8" Height="8" VerticalAlignment="Center"/>
                        </StackPanel>
                    </MenuItem.Header>
                    <MenuItem x:Name="mapFlipMenuItem" Header="{resx:Localize MainFrame_mapFlipMenuItem_Text}"
                              Command="{Binding AddMapFlipControlCommand}">
                        <MenuItem.Icon>
                            <Image Source="/Assets/Toolbar/mapFlipMenuItem.png" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="mapExchangeControlToolStripMenuItem" Header="{resx:Localize MainFrame_mapExchangeControlToolStripMenuItem_Text}"
                              Command="{Binding AddMapExchangeControlCommand}">
                        <MenuItem.Icon>
                            <Image Source="/Assets/Toolbar/mapExchangeControlItem.png" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="mapExchangeSeparateToolStripMenuItem" Header="{resx:Localize MainFrame_mapExchangeSeparateToolStripMenuItem_Text}"
                              Command="{Binding AddMapExchangeSeparateCommand}">
                        <MenuItem.Icon>
                            <Image Source="/Assets/Toolbar/mapExchangeSeparateItem.png" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
            </Menu>

            <!-- Add Variation (image + text) -->
            <Button x:Name="addVariationToolStripButton" Padding="2,2"
                    Command="{Binding AddVariationCommand}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Image Source="/Assets/Toolbar/addVariation.png" Width="16" Height="16"/>
                    <TextBlock Text="{resx:Localize MainFrame_addVariationToolStripButton_Text}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Special Items dropdown (image + text, click opens flyout menu) -->
            <Menu x:Name="specialItemToolStripMenu">
                <MenuItem>
                    <MenuItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Image Source="/Assets/Toolbar/specialItem.png" Width="16" Height="16"/>
                            <TextBlock Text="{resx:Localize MainFrame_specialItemToolStripMenu_Text}"
                                       VerticalAlignment="Center"/>
                            <PathIcon Data="M1939 486L2029 576L1024 1581L19 576L109 486L1024 1401L1939 486Z"
                                     Width="8" Height="8" VerticalAlignment="Center"/>
                        </StackPanel>
                    </MenuItem.Header>
                        <MenuItem x:Name="mapIssuePointToolStripMenuItem" Header="{resx:Localize MainFrame_mapIssuePointToolStripMenuItem_Text}"
                                  Command="{Binding AddMapIssueCommand}">
                            <MenuItem.Icon>
                                <Image Source="/Assets/Toolbar/mapIssuePointItem.png" Width="16" Height="16"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="mandatoryCrossingPointToolStripMenuItem" Header="{resx:Localize MainFrame_mandatoryCrossingPointToolStripMenuItem_Text}"
                                  Command="{Binding AddMandatoryCrossingCommand}">
                            <MenuItem.Icon>
                                <Image Source="/Assets/Toolbar/mandatoryCrossingPointItem.png" Width="16" Height="16"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="optionalCrossingPointToolStripMenuItem" Header="{resx:Localize MainFrame_optionalCrossingPointToolStripMenuItem_Text}"
                                  Command="{Binding AddOptCrossingCommand}">
                            <MenuItem.Icon>
                                <Image Source="/Assets/Toolbar/optionalCrossingPointItem.png" Width="16" Height="16"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="outOfBoundsToolStripMenuItem" Header="{resx:Localize MainFrame_outOfBoundsToolStripMenuItem_Text}"
                                  IsVisible="{Binding !AddOutOfBoundsUsesDangerousIcon}"
                                  Command="{Binding AddOutOfBoundsCommand}">
                            <MenuItem.Icon>
                                <Image Source="/Assets/Toolbar/outOfBoundsItem.png" Width="16" Height="16"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="outOfBoundsToolStripMenuItemWithDangerousIcon" Header="{resx:Localize MainFrame_outOfBoundsToolStripMenuItem_Text}"
                                  IsVisible="{Binding AddOutOfBoundsUsesDangerousIcon}"
                                  Command="{Binding AddOutOfBoundsCommand}">
                            <MenuItem.Icon>
                                <Image Source="/Assets/Toolbar/dangerousItem.png" Width="16" Height="16"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="dangerousToolStripMenuItem" Header="{resx:Localize MainFrame_dangerousToolStripMenuItem_Text}"
                                  IsVisible="{Binding IsVisibleDangerousArea}"
                                  Command="{Binding AddDangerousCommand}">
                            <MenuItem.Icon>
                                <Image Source="/Assets/Toolbar/dangerousItem.png" Width="16" Height="16"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="constructionToolStripMenuItem" Header="{resx:Localize MainFrame_constructionToolStripMenuItem_Text}"
                                  Command="{Binding AddConstructionCommand}">
                            <MenuItem.Icon>
                                <Image Source="/Assets/Toolbar/specialItem.png" Width="16" Height="16"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="waterLocationToolStripMenuItem" Header="{resx:Localize MainFrame_waterLocationToolStripMenuItem_Text}"
                                  Command="{Binding AddWaterCommand}">
                            <MenuItem.Icon>
                                <Image Source="/Assets/Toolbar/waterLocationItem.png" Width="16" Height="16"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="firstAidLocationToolStripMenuItem" Header="{resx:Localize MainFrame_firstAidLocationToolStripMenuItem_Text}"
                                  Command="{Binding AddFirstAidCommand}">
                            <MenuItem.Icon>
                                <Image Source="/Assets/Toolbar/firstAidLocationItem.png" Width="16" Height="16"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="forbiddenRouteMarkingToolStripMenuItem" Header="{resx:Localize MainFrame_forbiddenRouteMarkingToolStripMenuItem_Text}"
                                  Command="{Binding AddForbiddenCommand}">
                            <MenuItem.Icon>
                                <Image Source="/Assets/Toolbar/forbiddenRouteMarkingItem.png" Width="16" Height="16"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="boundaryToolStripMenuItem" Header="{resx:Localize MainFrame_boundaryToolStripMenuItem_Text}"
                                  Command="{Binding AddBoundaryCommand}">
                            <MenuItem.Icon>
                                <Image Source="/Assets/Toolbar/boundaryItem.png" Width="16" Height="16"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="registrationMarkToolStripMenuItem" Header="{resx:Localize MainFrame_registrationMarkToolStripMenuItem_Text}"
                                  Command="{Binding AddRegMarkCommand}">
                            <MenuItem.Icon>
                                <Image Source="/Assets/Toolbar/registrationMarkItem.png" Width="16" Height="16"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem x:Name="whiteOutToolStripMenuItem" Header="{resx:Localize MainFrame_whiteOutToolStripMenuItem_Text}"
                                  Command="{Binding AddWhiteOutCommand}">
                            <MenuItem.Icon>
                                <Image Source="/Assets/Toolbar/whiteOutItem.png" Width="16" Height="16"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="textToolStripMenuItem" Header="{resx:Localize MainFrame_textToolStripMenuItem_Text}"
                                  Command="{Binding AddTextCommand}">
                            <MenuItem.Icon>
                                <Image Source="/Assets/Toolbar/textItem.png" Width="16" Height="16"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="imageToolStripMenuItem" Header="{resx:Localize MainFrame_imageToolStripMenuItem_Text}"
                                  Command="{Binding AddImageCommand}">
                            <MenuItem.Icon>
                                <Image Source="/Assets/Toolbar/imageItem.png" Width="16" Height="16"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="lineToolStripMenuItem" Header="{resx:Localize MainFrame_lineToolStripMenuItem_Text}"
                                  Command="{Binding AddLineCommand}">
                            <MenuItem.Icon>
                                <Image Source="/Assets/Toolbar/lineItem.png" Width="16" Height="16"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="rectangleToolStripMenuItem" Header="{resx:Localize MainFrame_rectangleToolStripMenuItem_Text}"
                                  Command="{Binding AddRectangleCommand}">
                            <MenuItem.Icon>
                                <Image Source="/Assets/Toolbar/rectangleItem.png" Width="16" Height="16"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="ellipseToolStripMenuItem" Header="{resx:Localize MainFrame_ellipseToolStripMenuItem_Text}"
                                  Command="{Binding AddEllipseCommand}">
                            <MenuItem.Icon>
                                <Image Source="/Assets/Toolbar/ellipseItem.png" Width="16" Height="16"/>
                            </MenuItem.Icon>
                        </MenuItem>
                </MenuItem>
            </Menu>
            <Separator Width="1" Margin="2,2"/>

            <!-- Add Bend (image only) -->
            <Button x:Name="addBendToolStripButton"
                    ToolTip.Tip="{resx:Localize MainFrame_addBendToolStripButton_ToolTipText}"
                    Padding="2,2"
                    Command="{Binding AddBendCommand}">
                <Image Width="16" Height="16"
                       Source="{Binding IsEffectivelyEnabled,
                                RelativeSource={RelativeSource Self},
                                Converter={x:Static avutil:DisabledImageConverter.Instance},
                                ConverterParameter=/Assets/Toolbar/addBend.png}"/>
            </Button>

            <!-- Add Gap (image only) -->
            <Button x:Name="addGapToolStripButton"
                    ToolTip.Tip="{resx:Localize MainFrame_addGapToolStripButton_ToolTipText}"
                    Command="{Binding AddGapCommand}"
                    Padding="2,2">
                <Image Width="16" Height="16"
                       Source="{Binding IsEffectivelyEnabled,
                                RelativeSource={RelativeSource Self},
                                Converter={x:Static avutil:DisabledImageConverter.Instance},
                                ConverterParameter=/Assets/Toolbar/addGap.png}"/>
            </Button>
        </StackPanel>

        <!-- ==================== COURSE TABS ==================== -->
        <!-- TabStrip for course selection. Tabs are bound to ViewModel tab names. -->
        <TabStrip x:Name="courseTabs" DockPanel.Dock="Top" 
                  Theme="{DynamicResource CardTabStrip}"
                  ItemsSource="{Binding TabNames}"
                  SelectedIndex="{Binding SelectedTabIndex}"
                  Background="#E0E0E0">
        </TabStrip>

        <!-- ==================== STATUS BAR ==================== -->
        <!-- Status bar at the bottom with status text, zoom controls, and coordinate display. -->
        <Grid x:Name="statusBar" DockPanel.Dock="Bottom" Height="26"
              ColumnDefinitions="*,Auto,Auto,Auto,Auto"
              Background="#F0F2F4">

            <!-- Status message (Spring = fills available space) -->
            <TextBlock x:Name="statusLabel" Grid.Column="0"
                       VerticalAlignment="Center" Margin="4,0"
                       TextTrimming="WordEllipsis"
                       Text="{Binding StatusBarText}"/>

            <Separator Grid.Column="1" Height="20" Width="1" Margin="2,2"/>

            <!-- Zoom percentage label -->
            <TextBlock x:Name="zoomAmountLabel" Grid.Column="2"
                       Text="{Binding MapZoomFactor, StringFormat='Zoom: {0:P0}'}"
                       VerticalAlignment="Center" Margin="4,0"/>

            <!-- Zoom slider (replaces WinForms ToolStripTrackBar) -->
            <Slider x:Name="zoomTracker" Grid.Column="3" Classes="statusBarSlider"
                    Width="140" Height="20" VerticalAlignment="Center"
                    Minimum="0" Maximum="100"
                    Value="{Binding ZoomSliderValue, Mode=TwoWay}"/>

            <!-- Coordinate display -->
            <Border Grid.Column="4" BorderBrush="Gray" BorderThickness="1" Margin="2,2,6,2"
                    CornerRadius="2" Padding="4,0">
                <TextBlock x:Name="locationDisplay"
                           Text="{Binding StatusBarLocationDisplay}"
                           VerticalAlignment="Center" MinWidth="120"/>
            </Border>
        </Grid>

        <!-- ==================== MAIN CONTENT AREA ==================== -->
        <!-- Horizontal split: left panel (descriptions/selection) | right panel (map viewer).
             Replaces WinForms splitContainer. Left panel is fixed width. -->
        <Grid x:Name="splitContainer" >
            <Grid.ColumnDefinitions>
                <!-- Have minimum widths for left and right panels so they don't collapse too much when gridsplitter is dragged. -->
				<ColumnDefinition Width="250" MinWidth="166"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <!-- === LEFT PANEL (splitDescription equivalent) === -->
            <!-- Vertical split: top (description/topology) | bottom (selection panel).
                 Replaces WinForms splitDescription. Bottom panel is fixed height. -->
            <Grid Grid.Column="0"  >
                <Grid.RowDefinitions>
                    <!-- Have minimum widths for left and right panels so they don't collapse too much when gridsplitter is dragged. -->
				    <RowDefinition Height="*" MinHeight="150"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="200" MinHeight="50"/>
                </Grid.RowDefinitions>


                <!-- Description/Topology area with radio button toggle -->
                <Grid x:Name="leftColumnPanel" Grid.Row="0" Background="White" ClipToBounds="True"
                      RowDefinitions="*,Auto">

                    <!-- Panel that overlays descriptionControl and panelTopology.
                         In WinForms, radio buttons toggle visibility between these two. -->
                    <Panel x:Name="panelDescriptionAndTopology" Grid.Row="0">

                        <!-- 
                             WinForms type: PurplePen.DescriptionControl
                             Displays the IOF course description table (control descriptions).
                             This is a custom control that renders the description grid,
                             supports selection, and fires Change/SelectedIndexChange events.
                        -->
                        <!-- Wrapped in a Panel (which inherits the MainWindowViewModel
                             DataContext) so the IsVisible binding resolves against the
                             MainWindowViewModel. DescriptionViewer itself overrides its
                             DataContext to DescriptionViewerViewModel, so a !ShowTopology
                             binding placed directly on it would not resolve. -->
                        <Panel IsVisible="{Binding !ShowTopology}">
                            <views:DescriptionViewer
                                x:Name="descriptionViewer"
                                DataContext="{Binding DescriptionViewerViewModel}"
                            />
                        </Panel>

                        <!-- Topology view panel (hidden by default, shown when radio button selected) -->
                        <Panel x:Name="panelTopology" IsVisible="{Binding ShowTopology}">

                            <!-- mapViewerTopology
                                 WinForms type: PurplePen.MapView.MapViewer
                                 Displays the topology/ordering view of the course.
                                 Configured with: ConstrainedScrolling=PinTop, MaxZoom=1,
                                 MouseWheel=Scroll, MiddleButtonAutoDrag=false.-->
                            <resx:MapViewer
                                x:Name="mapViewerTopology"
                                MapDisplay="{Binding TopologyMapDisplay}"
                                MapHighlights="{Binding TopologyHighlights}"
                                ToolTip="{Binding TopologyToolTip}"
                                FancyMouseActivity="TopologyViewer_MouseActivity"
                                ViewportController="{Binding TopologyViewport}"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Auto"
                                MouseWheelAction="Scroll"
                                ConstrainedScrolling="PinTop"
                                MinZoom="0.4"
                                MaxZoom="10">
                            </resx:MapViewer>

                        </Panel>
                    </Panel>

                    <!-- Radio buttons to toggle between Descriptions and Topology/Ordering views -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,*"
                          Background="#f5f5f5" >
                        <Grid.Styles>
                            <Style Selector="RadioButton:not(:checked)">
                                <Setter Property="Padding" Value="6,3"/>
                            </Style>
                            <Style Selector="RadioButton:checked">
                                <Setter Property="BorderBrush" Value="{DynamicResource SemiGrey4}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Padding" Value="6,2"/>
                            </Style>
                        </Grid.Styles>
                        <RadioButton x:Name="radioButtonDescriptions" Grid.Column="0"
                                     Theme="{DynamicResource ButtonRadioButton}"
                                     Classes="Small"
                                     HorizontalAlignment="Stretch"
                                     HorizontalContentAlignment="Center"
                                     Content="{resx:Localize MainFrame_radioButtonDescriptions_Text}"
                                     IsChecked="{Binding !ShowTopology, Mode=TwoWay}"/>
                        <RadioButton x:Name="radioButtonTopology" Grid.Column="1"
                                     Theme="{DynamicResource ButtonRadioButton}"
                                     Classes="Small"
                                     HorizontalAlignment="Stretch"
                                     HorizontalContentAlignment="Center"
                                     Content="{resx:Localize MainFrame_radioButtonTopology_Text}"
                                     IsEnabled="{Binding EnableTopology}"
                                     IsChecked="{Binding ShowTopology, Mode=TwoWay}"/>
                    </Grid>
                </Grid>

                <!-- GridSplitter between description area and selection panel -->
                <GridSplitter Grid.Row="1" Height="4" ResizeDirection="Rows" Padding="0 2 -2 2"/>

                <!-- SelectionPanel
                     Displays context-sensitive selection controls (properties panel).
                     Dynamically populated with controls based on the current selection
                     (control properties, leg properties, special object properties, etc.).
                     Background is white. Controls flow vertically. -->

                    <views:SelectionPanel Grid.Row="2"
                                          SelectionDescription="{Binding SelectedObjectDescription}"/>
            </Grid>

            <!-- GridSplitter between left and right panels -->
            <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns" Padding="2 0"/>

            <!-- === RIGHT PANEL (map viewer area) === -->
            <Grid Grid.Column="2" RowDefinitions="Auto,*" MinWidth="100">

                <!-- Course part banner (top of map area) — shows course parts, variations, properties -->
                <resx:CoursePartBanner x:Name="coursePartBanner"
                                       Grid.Row="0"
                                       DataContext="{Binding CoursePartBannerViewModel}"/>

                <!-- MapViewer
                     WinForms type: PurplePen.MapView.MapViewer
                     The main map display control. This is the largest and most complex custom control.
                     Configured with: ConstrainedScrolling=KeepSome, MaxZoom=100,
                     MouseWheel=Zoom, MiddleButtonAutoDrag=true, HoverDelay=400ms.
                     Renders the orienteering map with course overlays using MapDisplay.
                     Handles mouse events for course editing (adding controls, moving items, etc.).
                     Scroll bars are provided internally by the PanAndZoom control. -->
                <resx:MapViewer
                    x:Name="mapViewer"
                    Grid.Row="1"
                    MapDisplay="{Binding MapDisplay}"
                    MapHighlights="{Binding MapHighlights}"
                    ToolTip="{Binding MapViewerToolTip}"
                    FancyMouseActivity="MapViewer_MouseActivity"
                    MouseLocation="{Binding MouseLocationInMap, Mode=OneWayToSource}"
                    PixelSize="{Binding MapViewerPixelSize, Mode=OneWayToSource}"
                    ZoomFactor="{Binding MapZoomFactor, Mode=TwoWay}"
                    ViewportController="{Binding MapViewport}"
                    HorizontalScrollBarVisibility="Visible"
                    VerticalScrollBarVisibility="Visible"
                    ConstrainedScrolling="KeepSome"
                    MouseWheelAction="Zoom"
                    MinZoom="0.1"
                    MaxZoom="100"
                />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
